GITLAB_ADMIN_EMAIL=admin@domain.com
GITLAB_HOSTNAME=gitlab.domain.com
GITLAB_IMAGE=docker.io/gitlab/gitlab-ce
GITLAB_IMAGE_TAG=latest
GITLAB_SSO_ASSERTION_CONSUMER_SERVICE_URL=https://gitlab.domain.com/users/auth/saml/callback
GITLAB_SSO_IDP_CERT_FINGERPRINT=
GITLAB_SSO_IDP_SSO_TARGET_URL=https://login.microsoftonline.com//saml2
GITLAB_SSO_ISSUER=https://gitlab.domain.com
GITLAB_SSO_NAME_IDENTIFIER_FORMAT=urn:oasis:names:tc:SAML:2.0:nameid-format:persistent
GITLAB_URL=https://gitlab.domain.com
